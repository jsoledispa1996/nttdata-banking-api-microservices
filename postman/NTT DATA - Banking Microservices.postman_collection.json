            "description": "## Login con JWT\n\n**✅ ACTUALIZADO**: El token ahora expira en **5 minutos** (300 segundos)\n\n### Usuarios de Prueba (confirmado funcionando)\n| Usuario | Password | Descripción |\n|---------|----------|-----------|\n| `admin` | `1234` | Usuario administrador ✅ FUNCIONANDO |\n\n### Respuesta Exitosa\n```json\n{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n  \"tokenType\": \"Bearer\",\n  \"expiresIn\": 300,\n  \"customerCode\": \"admin\",\n  \"name\": \"admin\",\n  \"roles\": [\"ROLE_ADMIN\"],\n  \"authorities\": [\"read:customers\", \"write:customers\", \"read:accounts\", \"write:accounts\", \"read:movements\", \"write:movements\", \"read:reports\"]\n}\n```\n\n### Auto-guardado\nEl token se guarda automáticamente en `{{authToken}}` y se usa en todas las peticiones autenticadas.\n\n**✅ PERFECTO**: Tiempo suficiente para hacer todas las pruebas necesarias."
          },
          "response": []
        },
        {
          "name": "Validar Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('🔍 VALIDAR TOKEN - Respuesta recibida:');",
                  "console.log('📊 Status Code:', pm.response.code);",
                  "console.log('📄 Response Text:', pm.response.text());",
                  "",
                  "// Debuggear la petición que se envió",
                  "console.log('📤 PETICIÓN ENVIADA:');",
                  "console.log('📍 URL:', pm.request.url.toString());",
                  "console.log('📍 Method:', pm.request.method);",
                  "",
                  "// Verificar headers de autorización enviados",
                  "const authHeader = pm.request.headers.get('Authorization');",
                  "if (authHeader) {",
                  "    console.log('📍 Authorization Header enviado:', authHeader.substring(0, 60) + '...');",
                  "    if (authHeader.startsWith('Bearer ')) {",
                  "        console.log('✅ Header tiene formato Bearer correcto');",
                  "        const tokenPart = authHeader.substring(7); // Remove 'Bearer '",
                  "        if (tokenPart.split('.').length === 3) {",
                  "            console.log('✅ Token en header tiene formato JWT válido');",
                  "        } else {",
                  "            console.log('❌ Token en header NO tiene formato JWT válido');",
                  "        }",
                  "    } else {",
                  "        console.log('❌ Header Authorization NO tiene formato Bearer');",
                  "    }",
                  "} else {",
                  "    console.log('❌ NO se envió header Authorization');",
                  "}",
                  "",
                  "console.log('📋 Todos los headers enviados:', JSON.stringify(pm.request.headers.toObject(), null, 2));",
                  "",
                  "if (pm.response.code === 200) {",
                  "    try {",
                  "        const response = pm.response.json();",
                  "        console.log('✅ Token válido - Respuesta:', JSON.stringify(response, null, 2));",
                  "        ",
                  "        pm.test('Token válido', function () {",
                  "            pm.response.to.have.status(200);",
                  "        });",
                  "    } catch (error) {",
                  "        console.log('❌ Error parseando respuesta JSON:', error.message);",
                  "    }",
                  "} else if (pm.response.code === 400) {",
                  "    console.log('❌ BAD REQUEST - Posibles causas:');",
                  "    console.log('  1. Token mal formateado');",
                  "    console.log('  2. Header Authorization incorrecto');",
                  "    console.log('  3. Token vacío o nulo');",
                  "    console.log('  4. Formato Bearer incorrecto');",
                  "    console.log('  5. Variable {{authToken}} no se resolvió');",
                  "    ",
                  "    // Intentar mostrar detalles del error",
                  "    try {",
                  "        const errorResponse = pm.response.json();",
                  "        console.log('📝 Detalles del error:', JSON.stringify(errorResponse, null, 2));",
                  "    } catch (e) {",
                  "        console.log('📝 Respuesta de error (texto):', pm.response.text());",
                  "    }",
                  "} else if (pm.response.code === 401) {",
                  "    console.log('❌ Token inválido o expirado - Ejecuta Login nuevamente');",
                  "} else {",
                  "    console.log('❌ Error inesperado:', pm.response.code, pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
