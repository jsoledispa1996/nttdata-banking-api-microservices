  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Debug: Verificar variables disponibles",
          "const envToken = pm.environment.get('authToken');",
          "const globalToken = pm.globals.get('authToken');",
          "const token = envToken || globalToken;",
          "",
          "if (token) {",
          "    console.log('🔑 Token encontrado (primeros 50 chars):', token.substring(0, 50) + '...');",
          "    ",
          "    // Mostrar información del usuario si está disponible",
          "    const customerCode = pm.environment.get('currentCustomerCode') || pm.globals.get('currentCustomerCode');",
          "    const userName = pm.environment.get('currentUserName') || pm.globals.get('currentUserName');",
          "    if (customerCode) console.log('👤 Customer Code:', customerCode);",
          "    if (userName) console.log('📝 Usuario:', userName);",
          "} else {",
          "    console.log('⚠️ No se encontró token. Ejecuta Login primero.');",
          "}",
          "",
          "// Verificar expiración del token (ahora con 5 minutos)",
          "const tokenExpiration = pm.environment.get('tokenExpiration') || pm.globals.get('tokenExpiration');",
          "if (tokenExpiration) {",
          "    const expirationDate = new Date(tokenExpiration);",
          "    const now = new Date();",
          "    const secondsUntilExpiration = (expirationDate - now) / 1000;",
          "    ",
          "    if (secondsUntilExpiration <= 0) {",
          "        console.log('❌ Token EXPIRADO. Ejecuta Login nuevamente.');",
          "    } else if (secondsUntilExpiration < 60) {",
          "        console.log('⚠️ Token expira en', Math.round(secondsUntilExpiration), 'segundos. Considera renovar.');",
          "    } else {",
          "        const minutesLeft = Math.round(secondsUntilExpiration / 60);",
          "        console.log('⏰ Token válido por', minutesLeft, 'minuto(s) más.');",
          "    }",
          "}"
        ]
      }
    }
  ],
